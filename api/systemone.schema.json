{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/compass/api/systemone.schema.json",
  "title": "Compass /v1/systemone",
  "description": "Request and response contract for Compass. Wire-compatible with TypeSafe's public POST /v1/systemone format, which is what JevBench's `typesafe` adapter sends and reads. Semantic checks the schema cannot express (a choice must name one of its own options; probabilities must sum to 1; score levels are keyed \"0\"..\"k\") are enforced in compass/contract.py.",
  "$defs": {
    "text": {
      "description": "A string, or JSON structure that is serialised deterministically before the model reads it.",
      "anyOf": [{"type": "string"}, {"type": "object"}, {"type": "array"}]
    },
    "choiceQuestion": {
      "type": "object",
      "required": ["type", "instructions", "criteria"],
      "additionalProperties": false,
      "properties": {
        "type": {"const": "choice"},
        "instructions": {"$ref": "#/$defs/text"},
        "criteria": {
          "description": "Option key -> description. Key order never changes the answer.",
          "type": "object",
          "minProperties": 2,
          "maxProperties": 64,
          "propertyNames": {"minLength": 1},
          "additionalProperties": {"$ref": "#/$defs/text"}
        }
      }
    },
    "scoreQuestion": {
      "type": "object",
      "required": ["type", "instructions", "criteria"],
      "additionalProperties": false,
      "properties": {
        "type": {"const": "score"},
        "instructions": {"$ref": "#/$defs/text"},
        "criteria": {
          "description": "Ordered level descriptions; index i describes level i.",
          "type": "array",
          "minItems": 2,
          "maxItems": 64,
          "items": {"$ref": "#/$defs/text"}
        }
      }
    },
    "noulQuestion": {
      "type": "object",
      "required": ["type", "instructions"],
      "additionalProperties": false,
      "properties": {
        "type": {"const": "noul"},
        "instructions": {"$ref": "#/$defs/text"},
        "criteria": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "true": {"$ref": "#/$defs/text"},
            "false": {"$ref": "#/$defs/text"}
          }
        }
      }
    },
    "probabilities": {
      "type": "object",
      "additionalProperties": {"type": "number", "minimum": 0, "maximum": 1}
    },
    "choiceAnswer": {
      "type": "object",
      "required": ["type", "choice", "confidence", "probabilities"],
      "additionalProperties": false,
      "properties": {
        "type": {"const": "choice"},
        "choice": {"type": "string"},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "probabilities": {"$ref": "#/$defs/probabilities"}
      }
    },
    "scoreAnswer": {
      "type": "object",
      "required": ["type", "score", "confidence", "legend", "probabilities"],
      "additionalProperties": false,
      "properties": {
        "type": {"const": "score"},
        "score": {"type": "number", "minimum": 0, "description": "Probability-weighted level."},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "legend": {"type": "object", "additionalProperties": {"type": "string"}},
        "probabilities": {"$ref": "#/$defs/probabilities"}
      }
    },
    "noulAnswer": {
      "type": "object",
      "required": ["type", "noul"],
      "additionalProperties": false,
      "properties": {
        "type": {"const": "noul"},
        "noul": {"type": "number", "minimum": 0, "maximum": 1, "description": "P(yes)."}
      }
    },
    "request": {
      "type": "object",
      "required": ["state", "questions"],
      "additionalProperties": false,
      "properties": {
        "model": {"type": "string", "description": "compass-latest or a pinned compass-X.Y.Z; omitted means latest."},
        "state": {"$ref": "#/$defs/text"},
        "questions": {
          "type": "object",
          "minProperties": 1,
          "maxProperties": 100,
          "propertyNames": {"minLength": 1},
          "additionalProperties": {
            "oneOf": [
              {"$ref": "#/$defs/choiceQuestion"},
              {"$ref": "#/$defs/scoreQuestion"},
              {"$ref": "#/$defs/noulQuestion"}
            ]
          }
        }
      }
    },
    "response": {
      "type": "object",
      "required": ["model", "answers", "usage"],
      "additionalProperties": false,
      "properties": {
        "model": {"type": "string", "description": "The pinned id that answered."},
        "answers": {
          "type": "object",
          "additionalProperties": {
            "oneOf": [
              {"$ref": "#/$defs/choiceAnswer"},
              {"$ref": "#/$defs/scoreAnswer"},
              {"$ref": "#/$defs/noulAnswer"}
            ]
          }
        },
        "usage": {
          "type": "object",
          "required": ["input_tokens", "output_tokens"],
          "additionalProperties": false,
          "properties": {
            "input_tokens": {"type": "integer", "minimum": 0, "description": "Every token the backbone processed: the state once plus each question's rubric."},
            "output_tokens": {"type": "integer", "const": 0, "description": "Compass never generates tokens."}
          }
        }
      }
    },
    "error": {
      "type": "object",
      "required": ["error"],
      "properties": {
        "error": {
          "type": "object",
          "required": ["type", "message"],
          "properties": {
            "type": {"enum": ["invalid_json", "invalid_request", "unknown_model", "model_error"]},
            "message": {"type": "string"}
          }
        }
      }
    }
  }
}
